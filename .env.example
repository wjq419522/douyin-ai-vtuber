# ===== 大模型（任意 OpenAI 兼容接口：DeepSeek / 通义千问 / 智谱 / Kimi / 本地 Ollama 等）=====
# 不填则使用内置“离线演示大脑”，可以先跑通流程
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 作画（OpenAI 兼容 /images/generations，如通义万相兼容网关、硅基流动、本地 SD WebUI 代理）=====
# 不填则前端用程序生成“水墨山水”兜底
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# ===== 语音合成 =====
# edge = 服务端 edge-tts；browser = 浏览器自带 TTS；none = 只出字幕
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoyiNeural

# ===== 抖音开放平台·直播互动（官方弹幕推送）=====
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
# 仅本地调试时设为 1，跳过推送签名校验。上线必须为 0
DOUYIN_SKIP_VERIFY=1

# ===== 运营安全 =====
# 操作员心跳超时（秒）。超时后机器人自动停止回复并显示“主播暂离”
OPERATOR_TIMEOUT=120
# auto=自动回复 / review=每条回复需操作员批准
REPLY_MODE=review
